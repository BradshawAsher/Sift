#lang ivy1.7

# ==============================================================================
# SIFT TWO-PHASE COMMIT: SYSTEM ISOLATE (twophase_system.ivy)
# ==============================================================================
# Implements the distributed Two-Phase Commit (2PC) protocol.
#
# Roles:
#   - Node 0: Transaction Manager (TM coordinator).
#   - Nodes N ~= 0: Resource Managers (RMs).
#
# Crucial Distributed Systems Contrast with Paxos/Raft:
#   - 2PC requires UNANIMITY: Every single participant in `tm_allset` must vote
#     `prepared` before the TM can issue a commit decision (`nset.allset`).
#   - If even one RM fails or aborts, the entire transaction must abort.
#   - In Paxos/Raft, only a MAJORITY quorum is needed, allowing progress despite
#     node crashes.
# ==============================================================================

include twophase_trans
include tcommit

isolate system = {

    axiom true # needed because of a bug in ivy_to_vmt

    # Node lifecycle states:
    #   ini:       Initial state for TM waiting for RM prepare votes
    #   working:   Initial active state for RMs processing the local transaction
    #   prepared:  RM has secured local resources and voted YES to commit
    #   committed: Terminal decision to permanently commit transaction
    #   aborted:   Terminal decision to roll back transaction
    object rm_state = {
        type this = {ini, working, prepared, committed, aborted}
    }

    individual emptynset: nset

    after init {
        emptynset := nset.emptyset;
    }

    object server(self:node) = {

        individual state: rm_state

        relation is_tm
        individual tm_prepset: nset  # Set of RMs that have voted PREPARED
        individual tm_allset: nset   # Complete set of RMs participating in transaction

        after init {
            state := rm_state.ini if self = 0 else rm_state.working;
            is_tm := true if self = 0 else false;
            tm_allset := emptynset;
            tm_prepset := emptynset;
        }

        # ----------------------------------------------------------------------
        # ACTION: prepare (RM Votes YES to Commit)
        # ----------------------------------------------------------------------
        # An RM currently working transitions to `prepared` and informs the TM:
        action prepare = {
            if ~is_tm & state = rm_state.working {
                call trans.send_working(self); # Registers participant with the TM
                state := rm_state.prepared;
                call trans.send_prepared(self);
                #call protocol.rMPrepare(self);  
                call spec.prepare(self);
            } 
        }

        # ----------------------------------------------------------------------
        # ACTION: commit (TM Decides Global Commit on Unanimity)
        # ----------------------------------------------------------------------
        # The TM decides COMMIT if and only if EVERY participant has voted PREPARED:
        action commit = {
            # Unanimity check: all registered nodes (plus TM node 0) must be in prepset:
            if is_tm & state = rm_state.ini & nset.allset(tm_prepset.add(0)) { 
                state := rm_state.committed;
                call trans.send_committed(self);
                #call protocol.tMCommit
            }
        }

        # ----------------------------------------------------------------------
        # ACTION: abort (TM or RM Decides Transaction Abort)
        # ----------------------------------------------------------------------
        # TM aborts if an RM fails/rejects; an RM can abort unilaterally if it cannot prepare:
        action abort = {
            if is_tm & state = rm_state.ini { 
                state := rm_state.aborted;
                call trans.send_aborted(self);
                #call protocol.tMAbort
            } else if ~is_tm & state = rm_state.working {
                state := rm_state.aborted;
                call trans.send_aborted(self);
                call spec.decide_abort(self);
            }
        }

        # ----------------------------------------------------------------------
        # MESSAGE HANDLERS: Tracking Participant Responses
        # ----------------------------------------------------------------------
        # TM registers participant RM in the cohort set:
        implement trans.handle_working(n:node) {
            if is_tm & n ~= 0 {
                tm_allset := tm_allset.add(n);
            }
        }

        # TM collects prepared vote from participant RM:
        implement trans.handle_prepared(n:node) {
            if is_tm & n ~= 0 & state = rm_state.ini {
                if ~nset.member(n, tm_allset) {
                    tm_allset := tm_allset.add(n);
                };
                tm_prepset := tm_prepset.add(n);
                #call protocol.tMRcvPrepared(n);
            }
        }

        # RM receives global commit decision from TM (node 0):
        implement trans.handle_committed(n:node) {
            if ~is_tm & n = 0 {
                state := rm_state.committed;
                call spec.decide_commit(self);
            }
        }

        # RM receives global abort decision from TM (node 0):
        implement trans.handle_aborted(n:node) {
            if ~is_tm & n = 0 {
                state := rm_state.aborted;
                call spec.decide_abort(self);
            }
        }

    }

    # Simulation Refinement: Network decisions imply specification decisions
    invariant [refinement1] N ~= 0 & trans.committed(N) -> spec.committed(N)
    invariant [refinement3] N ~= 0 & trans.aborted(N) -> spec.aborted(N)

    # --------------------------------------------------------------------------
    # HISTORICAL IC3PO SYNTHESIZED INVARIANTS (Annotated for Reference):
    # --------------------------------------------------------------------------
    # Synthesized by IC3PO for Two-Phase Commit (2PC).

    # [ic3po_global1_2] Designated Transaction Manager:
    # Node 0 is statically designated as the central Transaction Manager (TM).
# invariant [ic3po_global1_2]     system.server.is_tm(0)

    # [ic3po_other3] Registered Participant Activity:
    # Every node N2 tracked in the TM's active cohort (tm_allset) participated by sending a working message.
# invariant [ic3po_other3]        (forall N2, N1 . (nset.member(N2, system.server.tm_allset(N1)) -> trans.working(N2)))

    # [ic3po_other9] Complete Cohort Membership on Commit:
    # A commit message broadcast requires all participating nodes to be members of the TM's tracked cohort.
# invariant [ic3po_other9]        (forall N2, N1 . (trans.committed(N2) -> (nset.member(N1, system.server.tm_allset(N2)) | (N2 = N1))))

    # [ic3po_global5_12_1] Prepared State Precondition:
    # An RM cannot vote "prepared" without having first been active ("working") on the transaction.
# invariant [ic3po_global5_12_1]  (forall N1 . (trans.prepared(N1) -> trans.working(N1)))

    # [ic3po_global6_13] Prepared Subset Property:
    # The set of nodes that voted "prepared" (tm_prepset) is always a subset of all cohort participants (tm_allset).
# invariant [ic3po_global6_13]    (forall N1, N2 . (nset.member(N1, system.server.tm_prepset(N2)) -> nset.member(N1, system.server.tm_allset(N2))))

    # [ic3po_global1_5] Working State Excludes Abort:
    # An RM currently in the working state has not aborted.
# invariant [ic3po_global1_5]     (forall N1 . ((system.server.state(N1) = system.rm_state.working) -> ~trans.aborted(N1)))

    # [ic3po_global1_1] TM Uniqueness:
    # Only node 0 can be the Transaction Manager.
# invariant [ic3po_global1_1]     (forall N1 . (system.server.is_tm(N1) -> (0 = N1)))

    # [ic3po_global5_7] TM Commit Authority:
    # An individual RM can only commit if the TM (node 0) has decided and broadcast the global commit.
# invariant [ic3po_global5_7]     (forall N1 . (spec.committed(N1) -> trans.committed(0)))

    # [ic3po_global5_15] Local vs Network State Consistency:
    # Once a node transitions into local working state, its initial join message has been consumed.
# invariant [ic3po_global5_15]    (forall N1 . ((system.server.state(N1) = system.rm_state.working) -> ~trans.working(N1)))

    # [ic3po_global1_9] Exhaustive Participant State Partition:
    # Every cohort member RM is in exactly one of the 2PC lifecycle states: working, prepared, committed, or aborted.
# invariant [ic3po_global1_9]     (forall N2, N1 . (system.server.is_tm(N2) -> (spec.committed(N1) | spec.prepared(N1) | spec.aborted(N1) | spec.working(N1) | (N2 = N1))))
} with spec, nset, trans

export system.server.prepare
export system.server.commit
export system.server.abort

extract iso_impl(self:node) = nset, node, system, system.server(self), trans(self), net(self)
