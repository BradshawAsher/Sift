#lang ivy1.7

include nodes

isolate spec = {

	relation working(R:node)
	relation prepared(R:node)
	relation committed(R:node)
	relation aborted(R:node)

	after init {
		working(R) := true;
		working(0) := false;
		prepared(R) := false;
		committed(R) := false;
		aborted(R) := false;
	}

	action prepare(rm:node) = {
		if  working(rm) & rm ~= 0 {
			working(rm) := false;
			prepared(rm) := true;
			committed(rm) := false;
			aborted(rm) := false;
		}
	}

	action decide_commit(rm:node) = {
		if prepared(rm) & rm ~= 0 & forall R. R=0 | (prepared(R) | committed(R)) {
			working(rm) := false;
			prepared(rm) := false;
			committed(rm) := true;
			aborted(rm) := false;
		}
	}

	action decide_abort(rm:node) = {
		if rm ~= 0 & (working(rm) | prepared(rm)) & forall R. R=0 | ~committed(R) {
			working(rm) := false;
			prepared(rm) := false;
			committed(rm) := false;
			aborted(rm) := true;
		}
	}

	#export prepare
	#export decide_commit
	#export decide_abort

	invariant [safety] (forall R1, R2. ~(aborted(R1) & committed(R2)) )

	# --------------------------------------------------------------------------
	# HISTORICAL IC3PO SYNTHESIZED INVARIANTS (Annotated for Reference):
	# --------------------------------------------------------------------------
	# [ic3po_prop1] Fundamental 2PC Safety / Mutual Exclusion:
	# If any Resource Manager N1 has aborted, no Resource Manager N2 can ever commit.
	invariant [ic3po_prop1]	(forall N2, N1 . (spec.aborted(N1) -> ~spec.committed(N2)))

	# [ic3po_prop2] Terminal Abort State:
	# An RM that has aborted is never in the prepared state.
	invariant [ic3po_prop2]	(forall N0 . (spec.aborted(N0) -> ~spec.prepared(N0)))

	# [ic3po_global3] TM Spec Isolation (Commit):
	# Node 0 is the Transaction Manager coordinator, not an RM, so it never commits as a participant.
	invariant [ic3po_global3]	~spec.committed(0)

	# [ic3po_global3_1] TM Spec Isolation (Abort):
	# Node 0 is the Transaction Manager coordinator, so it never records a participant abort.
	invariant [ic3po_global3_1]	~spec.aborted(0)

} with node
