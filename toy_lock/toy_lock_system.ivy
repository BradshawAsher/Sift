#lang ivy1.7

# ==============================================================================
# SIFT DISTRIBUTED TOY LOCK: SYSTEM ISOLATE (toy_lock_system.ivy)
# ==============================================================================
# Implements the distributed lock server on each node.
# State per node:
#   - ep: Current epoch number witnessed by this node.
#   - held: Boolean flag indicating if this node currently holds the lock.
# Initial condition: Node 0 starts with the lock (held := true) at epoch 0.
# ==============================================================================

include timeout
include toy_lock_spec
include toy_lock_trans
include ring

isolate system = {
    object server(self: node) = {
        individual ep: epoch
        individual held: bool
        instance timer: timeout_sec

        after init {
            ep := 0;
            held := self = 0; # Node 0 holds the lock initially
        }

        # ----------------------------------------------------------------------
        # ACTION: timer.timeout (Release Lock & Pass Token Clockwise)
        # ----------------------------------------------------------------------
        # When a node holding the lock releases it, it relinquishes local ownership
        # (held := false) and transmits a transfer message with epoch incremented:
        implement timer.timeout {
            if held & epoch.next(ep) > ep {
                held := false;
                call trans.send_transfer(self, ring.next(self), ep.next);
            }
        }

        # ----------------------------------------------------------------------
        # ACTION: trans.handle_transfer (Receive Lock Token)
        # ----------------------------------------------------------------------
        # A node only accepts the lock if the transfer carries an epoch strictly
        # higher than any epoch the node has seen previously:
        implement trans.handle_transfer(e: epoch) {
            if e > ep {
                held := true;
                ep := e;
                call trans.send_locked(self, self, e);
                call spec.next(e, self);
            }
        }

    }

    invariant [safety] trans.locked(E, N) -> spec.lock_history(E, N)

    # --------------------------------------------------------------------------
    # HISTORICAL IC3PO SYNTHESIZED INVARIANTS (Annotated for Reference):
    # --------------------------------------------------------------------------
    # These invariants were synthesized by IC3PO to prove mutual exclusion on a ring.

    # [ic3po_other6] Unique Transfer Destination:
    # A lock transfer message for a specific epoch E1 can have only one recipient N1.
# invariant [ic3po_other6]        (forall N1, E1, N2 . ((trans.transfer(E1, N1) & trans.transfer(E1, N2)) -> (N2 = N1)))

    # [ic3po_other1] Transfer Provenance:
    # If node N2 currently holds the lock at epoch ep(N2), a valid transfer message for that epoch must have existed.
# invariant [ic3po_other1]        (forall N2, E1, N1 . ((system.server.held(N2) & trans.transfer(E1, N1)) -> trans.transfer(system.server.ep(N2), N2)))

    # [ic3po_other5] Active Lock Upper Bound:
    # While node N1 holds the lock at epoch ep(N1), any in-flight transfer message must belong to an older or current epoch (E1 <= ep(N1)).
# invariant [ic3po_other5]        (forall E1, N2, N1 . ((system.server.held(N1) & trans.transfer(E1, N2)) -> ((E1 < system.server.ep(N1)) | (E1 = system.server.ep(N1)))))

    # [ic3po_global1_5] Lock Grant Authenticity:
    # A locked notification for epoch E1 is authentic only if a corresponding transfer occurred (or E1=0 initial).
# invariant [ic3po_global1_5]     (forall N1, E1 . (trans.locked(E1, N1) -> (trans.transfer(E1, N1) | (0 = E1))))

    # [ic3po_global1_3] Spec History Alignment:
    # The specification lock history faithfully reflects actual locked messages from the protocol.
# invariant [ic3po_global1_3]     (forall N1, E1 . (spec.lock_history(E1, N1) -> ((0 = E1) | trans.locked(E1, N1))))

    # [ic3po_other2] Epoch Monotonicity in Transit:
    # Multiple in-flight transfers cannot jump ahead unpredictably: any second transfer E2 cannot exceed active frontier E1.
# invariant [ic3po_other2]        (forall E2, N2, E1, N1 . ((trans.transfer(E1, N1) & trans.transfer(E2, N2) & (system.server.ep(N1) < E1)) -> ((E2 = E1) | (E2 < E1))))

    # [ic3po_other3] Mutual Exclusion:
    # At most one node can hold the lock at any given time (held(N1) & held(N2) -> N1 = N2).
# invariant [ic3po_other3]        (forall N1, N2 . ((system.server.held(N1) & system.server.held(N2)) -> (N2 = N1)))
} with spec, epoch, trans

import trans.handle_locked

extract iso_impl(self:node) = node, system, system.server(self), trans(self), net(self), epoch, ring

