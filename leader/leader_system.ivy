#lang ivy1.7

# ==============================================================================
# SIFT RING LEADER ELECTION: PROTOCOL SYSTEM (leader_system.ivy)
# ==============================================================================
# Implements the distributed node logic for the Chang-Roberts election protocol.
# Each node has:
#   - A periodic timer (`timer.timeout`) that initiates candidacy by transmitting
#     its own unique ID to its clockwise neighbor (`ring.next(self)`).
#   - A message handler (`recv_forward`) that filters incoming candidate IDs.
# ==============================================================================

include leader_trans
include leader_spec
include timeout
include ring

isolate system = {
    object server(self: node) = {
        instance timer : timeout_sec

        # ----------------------------------------------------------------------
        # ACTION: timer.timeout (Initiate Election Candidacy)
        # ----------------------------------------------------------------------
        # When election timer fires, node injects its own identifier into the ring:
        implement timer.timeout {
            call trans.send_forward(self, ring.next(self), idn(self));
        }

        # ----------------------------------------------------------------------
        # ACTION: recv_forward (Filter or Elect Candidate)
        # ----------------------------------------------------------------------
        implement trans.recv_forward(i: id) {
            if i = idn(self) {
                # The node's own ID has completed a full loop around the ring!
                # Because lower IDs are discarded at intermediate nodes, completing
                # the circle proves this node has the strictly highest ID in the ring.
                call spec.elect(self);
                call trans.send_elected(self, self);
            } else if i > idn(self) {
                # Incoming ID is higher than local ID: forward clockwise to neighbor:
                call trans.send_forward(self, ring.next(self), i);
            }
            # Note: If i < idn(self), the message is dropped (filtered out).
        }
    }

    invariant [safety] trans.elected(N) -> spec.leader(N)

    # --------------------------------------------------------------------------
    # HISTORICAL IC3PO SYNTHESIZED INVARIANTS (Annotated for Reference):
    # --------------------------------------------------------------------------
    # Synthesized by IC3PO for the Chang-Roberts ring leader election protocol.

    # [ic3po_global1_2] Circuit Completion Requirement:
    # A node N1 is elected leader only if its own ID completed the full ring circuit
    # and was received back at N1.
# invariant [ic3po_global1_2]     (forall N1 . (trans.elected(N1) -> trans.forward(idn(N1), N1)))

    # [ic3po_global1_1] Spec Leader Alignment:
    # The specification leader predicate matches the network elected message.
# invariant [ic3po_global1_1]     (forall N1 . (spec.leader(N1) -> trans.elected(N1)))

    # [ic3po_other3] Global Maximality of Elected Leader:
    # If node N2's ID completed a full circuit back to N2, every other node N1 in the
    # entire network must have a strictly smaller ID (idn(N1) < idn(N2)).
# invariant [ic3po_other3]        (forall N1, N2 . (trans.forward(idn(N2), N2) -> ((idn(N1) < idn(N2)) | (N2 = N1))))

    # [ic3po_global3_22] Ring Segment Invariant (No Higher IDs Bypassed):
    # If N2's message reached node N1, then for any node N3 between N2 and N1 on the ring,
    # N3 cannot have an ID higher than N2 (otherwise N3 would have dropped N2's message).
# invariant [ic3po_global3_22]    (forall N1, N3, N2 . (trans.forward(idn(N2), N1) -> (ring.btw(N2, N1, N3) | (idn(N3) < idn(N2)) | (N2 = N1) | (N2 = N3) | (N1 = N3))))

    # [ic3po_global3_21] Monotonic Propagation Along Ring:
    # If N2's message reached N1, it was forwarded along each intermediate node N3 on the ring.
# invariant [ic3po_global3_21]    (forall N2, N1, N3 . (trans.forward(idn(N2), N1) -> (ring.btw(N2, N1, N3) | (N2 = N3) | trans.forward(idn(N2), N3))))
} with ring, spec, trans, id_injective, id

import trans.recv_elected

extract iso_impl(me:node) = system, system.server(me), net(me), trans(me), idn(me), node, id, ring
