#lang ivy1.7

# ==============================================================================
# SIFT RING LEADER ELECTION: NETWORK TRANSPORT SHIM (leader_trans.ivy)
# ==============================================================================
# This isolate defines the network abstraction layer ("trans") for the Chang-Roberts
# ring leader election protocol.
#
# Protocol Overview:
#   - Nodes are arranged in a unidirectional logical ring (ring.next).
#   - Each node possesses a unique identifier (id).
#   - Nodes circulate candidate IDs clockwise:
#       * If an incoming ID is greater than the node's own ID, it is forwarded.
#       * If it is strictly smaller, it is dropped (swallowed).
#       * If an ID returns to its originating node, that node knows it has the
#         globally maximal ID and elects itself leader!
# ==============================================================================

include udp
include common

# ------------------------------------------------------------------------------
# WIRE MESSAGE TYPES & PAYLOAD STRUCTURE
# ------------------------------------------------------------------------------
object msg_kind = {
    # Packet types:
    #   forward: Carries a candidate node ID clockwise along the ring
    #   elected: Sent notification that leader election has succeeded
    type this = {forward, elected}
}

object msg = {
    type this = struct {
        m_kind : msg_kind,
        m_id : id
    }
}

instance net : udp_simple(node, msg)

# ------------------------------------------------------------------------------
# ISOLATE: trans (Network Transport Shim)
# ------------------------------------------------------------------------------
isolate trans = {

    # Sends candidate ID `i` along the ring toward node `dst`
    action send_forward(src: node, dst: node, i:id)
    # Sends leader elected notification to `dst`
    action send_elected(src: node, dst: node)

    # Inbound message receivers:
    action recv_forward(dst: node, i: id)
    action recv_elected(dst: node)

    # --------------------------------------------------------------------------
    # TRANSPORT SPECIFICATION (Ghost relations tracking dispatched ring messages)
    # --------------------------------------------------------------------------
    specification {
        relation forward(I: id, N: node)
        relation elected(N: node)

        after init {
            forward(I, D) := false;
            elected(N) := false
        }

        before send_forward {
            forward(i, dst) := true;
        }

        before recv_forward {
            assert forward(i, dst);
        }

        before send_elected {
            elected(dst) := true;
        }

        before recv_elected {
            assert elected(dst);
        }
    }

    implementation {
        action debug_sending(src:node,dst:node,m:msg)
        action debug_receiving(dst:node,m:msg)

        implement net.recv(dst:node,m:msg) {
            call debug_receiving(dst,m);
            if m.m_kind = msg_kind.forward {
                call recv_forward(dst, m.m_id);
            } else if m.m_kind = msg_kind.elected {
                call recv_elected(dst);
            }
        }

        implement send_forward {
            var m: msg;
            m.m_kind := msg_kind.forward;
            m.m_id := i;
            call debug_sending(src, dst, m);
            call net.send(src, dst, m);
        }

        implement send_elected {
            var m: msg;
            m.m_kind := msg_kind.elected;
            call debug_sending(src, dst, m);
            call net.send(src, dst, m);
        }

        invariant net.spec.sent(M, D) & msg.m_kind(M) = msg_kind.forward -> forward(msg.m_id(M), D)
        invariant net.spec.sent(M, D) & msg.m_kind(M) = msg_kind.elected -> elected(D)
    }
} with net, id

import trans.debug_sending
import trans.debug_receiving
